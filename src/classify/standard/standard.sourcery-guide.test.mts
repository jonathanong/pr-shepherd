import { describe, expect, it } from "vitest";
import { fixture, matches } from "../../../test-helpers/standard-rule-variants.mts";

const START = "<!-- Generated by sourcery-ai[bot]: start review_guide -->";
const END = "<!-- Generated by sourcery-ai[bot]: end review_guide -->";
const RULE = "sourcery-review-guide";

describe("sourcery-review-guide", () => {
  const guide = fixture("sourcery-review-guide-pr-shepherd-809");
  const other = fixture("sourcery-review-guide-no-mistakes-3866");

  it("matches a guide framed by its markers, with surrounding whitespace", () => {
    expect(guide.body.startsWith(START)).toBe(true);
    expect(guide.body.endsWith(END)).toBe(true);
    expect(matches(guide, `\n  ${guide.body}\n\n`)).toEqual([RULE]);
  });

  it("matches an edited guide, since the rule reads the current body", () => {
    expect(matches(guide, other.body)).toEqual([RULE]);
  });

  it("keeps a guide with content before or after it visible", () => {
    expect(matches(guide, `Heads up.\n\n${guide.body}`)).toEqual([]);
    expect(matches(guide, `${guide.body}\n\nI found a bug in the authorization check.`)).toEqual(
      [],
    );
  });

  it("keeps a body with two guides visible", () => {
    expect(matches(guide, `${guide.body}\n\n${other.body}`)).toEqual([]);
  });

  it("keeps a guide with another marker kind visible", () => {
    const linked =
      "<!-- Generated by sourcery-ai[bot]: start linked_issues -->\nUnmet requirement.\n";
    const linkedEnd = "<!-- Generated by sourcery-ai[bot]: end linked_issues -->";
    expect(matches(guide, `${START}\n${linked}${linkedEnd}\n${END}`)).toEqual([]);
    expect(matches(guide, guide.body.replace(END, `${linkedEnd}\n${END}`))).toEqual([]);
  });

  it("keeps a body missing a marker visible", () => {
    expect(matches(guide, guide.body.slice(START.length))).toEqual([]);
    expect(matches(guide, guide.body.slice(0, -END.length))).toEqual([]);
    expect(matches(guide, `${START}\n${END}\n${START}`)).toEqual([]);
  });

  it("keeps the linked-issues comment visible", () => {
    expect(matches(guide, "<!-- Generated by sourcery-ai[bot]: start linked_issues -->")).toEqual(
      [],
    );
  });
});
