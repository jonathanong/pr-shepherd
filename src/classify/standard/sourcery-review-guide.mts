import type { ClassifyRule } from "../types.mts";
import { isBotItem } from "./author.mts";

const START = "<!-- Generated by sourcery-ai[bot]: start review_guide -->";
const END = "<!-- Generated by sourcery-ai[bot]: end review_guide -->";
const ANY_MARKER = /<!-- Generated by sourcery-ai\[bot\]: [^>]*-->/g;

/**
 * Sourcery's "Reviewer's Guide" conversation comment: a summary of the PR's own diff with a tips
 * section, edited in place on each push. The whole body must be one guide, framed by its start and
 * end markers. Any content outside them, a second guide, or a marker of another kind (such as the
 * linked-issues report, which can list unmet requirements) keeps it visible.
 */
const rule: ClassifyRule = (item) => {
  if (!isBotItem(item, ["sourcery-ai"], ["pr-comment"])) return null;
  const body = item.body.trim();
  if (!body.startsWith(START) || !body.endsWith(END)) return null;
  if ([...body.matchAll(ANY_MARKER)].length !== 2) return null;
  return { autoResolve: true, suppress: true, reason: "Sourcery Reviewer's Guide" };
};

export default rule;
